{
  "manifest_version": 3,
  "name": "无印豆包 - 素材提取",
  "version": "1.0.8",
  "description": "在豆包/Dola/千问页面提取无水印图片和视频，支持一键下载",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://*.snssdk.com/*",
    "https://*.douyinvod.com/*",
    "https://*.byteintlapi.com/*",
    "https://*.dola.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.doubao.com/thread/*",
        "https://www.doubao.com/share/*",
        "https://www.doubao.com/chat/*",
        "https://www.dola.com/thread/*",
        "https://www.dola.com/share/*",
        "https://www.dola.com/chat/*",
        "https://www.qianwen.com/chat/*",
        "https://www.qianwen.com/share/chat/*"
      ],
      "js": ["asset-loader.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.doubao.com/thread/*",
        "https://www.doubao.com/share/*",
        "https://www.doubao.com/chat/*",
        "https://www.dola.com/thread/*",
        "https://www.dola.com/share/*",
        "https://www.dola.com/chat/*",
        "https://www.qianwen.com/chat/*",
        "https://www.qianwen.com/share/chat/*"
      ],
      "js": ["video-crypto.js", "content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.html"],
      "matches": [
        "https://www.doubao.com/*",
        "https://www.dola.com/*",
        "https://www.qianwen.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "homepage_url": "https://github.com/ihmily/doubao-nomark"
}
